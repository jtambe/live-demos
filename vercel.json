{
  "services": {
    "frontend": {
      "root": "app/"
    },
    "backend": {
      "root": "api/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "frontend" }
    }
  ]
}