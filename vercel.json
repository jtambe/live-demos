{
  "services": {
    "frontend": {
      "root": "app/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "env": "NEXT_PUBLIC_BACKEND_URL",
          "format": "url"
        }
      ]
    },
    "backend": {
      "root": "api/",
      "entrypoint": "main:app"
    }
  }
}
