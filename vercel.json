{
  "services": {
    "frontend": {
      "root": "app/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "api/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/app/(.*)", "destination": { "service": "frontend" } }
  ]
}
